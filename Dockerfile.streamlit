FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

# curl p/ healthcheck; libexpat1 e lib de sistema exigida em runtime por rasterio
# (puxado pelo extra [basemap]/contextily) — ausente no python:3.11-slim -> sem ela,
# `import contextily` falha (libexpat.so.1) e o relatorio cai no fallback sem ruas.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libexpat1 \
    # Security: aplica o update do libssh2 (CVE-2026-55200 CRITICAL + 55199/7598 HIGH;
    # fix 1.11.1-1+deb13u1). E lib transitiva, mas tem fix disponivel -> remediar, nao
    # ignorar (politica .trivyignore: ignore so build-tools sem fix). Gate Trivy bloqueante.
    && apt-get install -y --only-upgrade libssh2-1t64 \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# [basemap] (contextily) embutido na imagem de producao para o fundo de ruas do
# Relatorio Pontual Censitario funcionar na VPS (DEC-004, escolha de Felipe 2026-06-05).
RUN python -m pip install --upgrade pip \
    && python -m pip install ".[basemap]" -c constraints.txt


# ─────────────────────────────────────────────────────────────────────────────
# BLK-SEC-04 — camada final de SEGURANCA. Fica por ULTIMO de proposito.
#
# PROBLEMA 1 (o que travou o deploy em 2026-07-30): o CI builda com
# `cache-from: type=gha` e a linha do `apt-get` acima nunca muda -> a camada de
# pacotes de SO ficava CONGELADA no estado da primeira vez que foi cacheada.
# Atualizacao de seguranca do Debian NUNCA chegava, por mais rebuilds que se
# fizesse. Foi assim que o `libexpat1` ficou preso em 2.7.1-2 com 2.8.2-1~deb13u1
# disponivel em `trixie-security` e 5 HIGH abertos.
# O `ARG APT_REFRESH` recebe o `github.run_id` no CI: muda a cada execucao, entao
# ESTA camada e' sempre refeita. Ela vem depois do `pip install` justamente para
# nao invalidar a camada cara — o custo e' ~20s de apt, nao o build inteiro.
#
# PROBLEMA 2: `pip`/`setuptools`/`wheel` ficavam na imagem de RUNTIME e arrastavam
# CVE de ferramenta de build (inclusive o `msgpack` VENDORIZADO dentro do pip).
# Era a divida que o proprio `.trivyignore` nomeava: "remediar de verdade = imagem
# sem build tools no runtime". Nenhum servico importa isso em runtime — os unicos
# usos de `setuptools_scm` no venv (matplotlib, pyarrow) estao sob `try` e so valem
# para checkout de git.
#
# Os DOIS smokes existem para que uma remocao errada quebre o BUILD, nunca a
# producao: se algum import parar de funcionar, a imagem nao e' publicada.
ARG APT_REFRESH=0
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/* \
    && python -c "import streamlit, contextily, rasterio, matplotlib, pyarrow, motor_expansao" \
    && (python -m pip uninstall -y wheel || true) \
    && (python -m pip uninstall -y setuptools || true) \
    && (python -m pip uninstall -y pip || true) \
    && python -c "import streamlit, contextily, rasterio, matplotlib, pyarrow, motor_expansao" \
    && echo "BLK-SEC-04: build tools removidos, imports intactos"

RUN useradd --create-home --shell /usr/sbin/nologin streamlit \
    && mkdir -p /app/data/outputs /app/data/staging \
    && chown -R streamlit:streamlit /app

USER streamlit

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
