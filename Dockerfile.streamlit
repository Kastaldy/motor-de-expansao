FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

# curl p/ healthcheck; libexpat1 e lib de sistema exigida em runtime por rasterio
# (puxado pelo extra [basemap]/contextily) — ausente no python:3.11-slim -> sem ela,
# `import contextily` falha (libexpat.so.1) e o relatorio cai no fallback sem ruas.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libexpat1 \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# [basemap] (contextily) embutido na imagem de producao para o fundo de ruas do
# Relatorio Pontual Censitario funcionar na VPS (DEC-004, escolha de Felipe 2026-06-05).
RUN python -m pip install --upgrade pip \
    && python -m pip install ".[basemap]"

RUN useradd --create-home --shell /usr/sbin/nologin streamlit \
    && mkdir -p /app/data/outputs /app/data/staging \
    && chown -R streamlit:streamlit /app

USER streamlit

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
