# ============================================================
# Motor de Expansao Ultra Academia - Variaveis de ambiente
# Copie para .env e preencha valores locais.
# Nunca commite .env.
# ============================================================

# --- Banco de dados / legado API ---
# Fora do deploy inicial. Mantido para desenvolvimento da API legada.
POSTGRES_USER=ultra
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=motor_expansao
DATABASE_URL=postgresql+asyncpg://ultra:sua_senha_aqui@localhost:5432/motor_expansao
DATABASE_URL_SYNC=postgresql+psycopg2://ultra:sua_senha_aqui@localhost:5432/motor_expansao

# --- APIs externas ---
# O dashboard de producao deste ciclo deve rodar offline com Parquets locais.
GOOGLE_MAPS_API_KEY=
GEOFUSION_API_KEY=
MAPBOX_TOKEN=
# Chave do ArcGIS Location Platform p/ a VISTA AEREA (satelite Esri) do Relatorio
# Pontual — DEC-018/BLK-SAT-01. Conta gratuita (2M tiles/mes), privilegio
# `premium:user:basemaps`. SEM esta chave a pagina de satelite e simplesmente
# omitida (o resto do PDF sai igual). Nunca commite o valor. A API le via
# settings (pydantic); o dashboard le a MESMA env var por os.environ.
API_ARCGIS_API_KEY=

# --- Monitoramento ---
SENTRY_DSN=
ENVIRONMENT=development

# --- Autenticacao / legado API ---
SECRET_KEY=gere_uma_chave_segura_aqui
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Configuracoes de scraping / pipelines ---
# Fora do deploy inicial.
SCRAPER_DELAY_MIN=2
SCRAPER_DELAY_MAX=5
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT=30

# --- Configuracoes geoespaciais / M1 ---
H3_RESOLUTION=7
DIST_MIN_ULTRA_KM=1.0
RENDA_MIN=4500
M1_SCORE_OFICIAL=score_priorizacao
M1_PRIORIZACAO_TOP_PCT_POR_UF=0.20
M1_OSM_ENABLED=false
M1_SETOR_CENSITARIO_OBRIGATORIO=false
M1_POP_MINIMA_PROXY=1

# --- Alertas ---
SLACK_WEBHOOK_URL=
ALERT_EMAIL=

# --- Authelia — segredos obrigatórios para deploy de produção ---
# Copiar para .env e preencher com valores reais (nunca commitar o .env)
# Gerar valores aleatórios: openssl rand -hex 32
AUTHELIA_JWT_SECRET=GERAR_COM_openssl_rand_hex_32
AUTHELIA_SESSION_SECRET=GERAR_COM_openssl_rand_hex_32
AUTHELIA_STORAGE_ENCRYPTION_KEY=GERAR_COM_openssl_rand_hex_32

# --- Piloto Web (serviço `web` do docker-compose.prod.yml) ---
# Container único: frontend Vite + backend FastAPI (serve o SPA e a API na :8899).
# Imagem por DIGEST imutável (modo PULL, publicada pelo CI publish-web). Fail-closed:
# `up` sem WEB_IMAGE falha de propósito. Obter o digest do job publish-web no Actions.
# Runbook (Caddy/Authelia/DNS/dados/deploy por digest): docs/deploy_piloto_web.md.
WEB_IMAGE=ghcr.io/kastaldy/motor-de-expansao/motor-expansao-web@sha256:<digest>

# --- API GeoEspacial + Bot Telegram (BLK-API-06/07) ---
# Usados pelos serviços `api` e `telegram-bot` do docker-compose.prod.yml.
# Prefixo API_ (pydantic-settings). Detalhes em docs/deploy_api_bot.md.
#
# Imagem da API/bot por DIGEST imutável (modo PULL, publicada pelo CI publish-api).
# Fail-closed: `up` sem API_IMAGE falha de propósito. Obter o digest do job
# publish-api no Actions (ou: docker buildx imagetools inspect ...:sha-<commit>).
API_IMAGE=ghcr.io/kastaldy/motor-de-expansao/motor-expansao-api@sha256:<digest>
#
# Mapa token -> consumidor (JSON). O bot autentica com um destes tokens.
# Gerar token aleatório: openssl rand -hex 24
API_TOKENS={"GERAR_TOKEN_FORTE":"bot-telegram"}
# Token que o bot usa p/ chamar a API — DEVE ser uma chave existente em API_TOKENS.
API_API_CALL_TOKEN=GERAR_TOKEN_FORTE
# Token do bot do @BotFather (Telegram).
API_TELEGRAM_TOKEN=
# Senha de acesso ao bot (quem acertar fica autorizado naquele chat).
API_BOT_SENHA=GERAR_SENHA_FORTE
# Origens CORS da API (default ["*"]). JSON valido — pydantic-settings decodifica o
# campo de lista como JSON na origem, entao um "*" cru quebra. Restringir em prod.
API_CORS_ORIGINS=["*"]
# Opcional: chave da Google Geocoding API. Vazio = geocoder por endereço usa
# Selenium/Chrome (primário, embutido na imagem) + Nominatim (fallback).
API_GOOGLE_MAPS_API_KEY=

# ── Basemap self-host (BLK-BASEMAP-02/05/06) ──────────────────────────────────
# Fundo de ruas dos PDFs pelo tileserver OpenMapTiles proprio. URL INTERNA da rede
# app_net (NAO a rota publica /tiles/, que esta atras do Authelia: um fetch
# server-side nao leva cookie -> 302 e o PDF sairia sem ruas, em silencio).
# Opcional: sem ela o basemap cai no CartoDB Voyager de antes.
API_BASEMAP_TILES_URL=http://motor_expansao_tileserver:8080/styles/ultra-maptiler/{z}/{x}/{y}@2x.png
# Rotulos (nomes de rua/avenida/bairro) compostos POR CIMA do choropleth, do MESMO
# tileserver. SEM esta var nao ha overlay e os mapas de calor saem sem nome nenhum —
# nao existe mais fallback para o CARTO (BLK-BASEMAP-06).
API_BASEMAP_LABELS_URL=http://motor_expansao_tileserver:8080/styles/ultra-labels/{z}/{x}/{y}@2x.png

# ── Banco PostgreSQL/PostGIS ──────────────────────────────────────────────────
# Três segredos, três papéis distintos, e a distinção NÃO é burocrática:
#
#   dono do schema  → aplica migration (DDL) e é o SECURITY DEFINER das triggers
#                     de auditoria do D19. Só ele pode desligar essas triggers.
#   app             → o que a aplicação usa. Sem DDL, GRANT tabela a tabela (D20).
#   auditoria       → só lê o histórico de permissões. Ninguém escreve com ele.
#
# Dar ao piloto a credencial do dono anularia o D19 em silêncio: a promessa de que
# a aplicação não consegue apagar o próprio rastro depende de ela não ser dona.

# Serviço `postgres` do compose. As três primeiras são fail-closed (${VAR:?}): sem
# elas o `docker compose up` ABORTA em vez de subir um banco com senha vazia na
# app_net. Só o DONO nasce aqui — os papéis `app` e `auditoria` são criados depois,
# rodando o `sql/papeis-e-privilegios.md` do banco-de-reservas (D20).
POSTGRES_DB=banco_de_reservas
POSTGRES_OWNER_USER=reservas_owner
POSTGRES_OWNER_PASSWORD=

# LIGA o banco no motor. AUSENTE ou vazia = banco não configurado: o piloto sobe e
# funciona exatamente como antes, sem tentar conexão nenhuma. É esse estado que
# permite a imagem ir para produção antes de o banco existir — e é também o
# interruptor de incidente: esvaziar e reiniciar o `web` devolve o piloto ao
# comportamento pré-banco, sem rebuild e sem tocar no compose.
#
# Formato libpq: postgresql://app:SENHA@postgres:5432/banco_de_reservas
# O host é o NOME DO SERVIÇO (`postgres`), não o container_name. O usuário é `app`,
# nunca ${POSTGRES_OWNER_USER} — ver a explicação dos três papéis acima.
#
# Senha com caractere especial (@ : / ?) precisa de percent-encoding na URL, ou a
# libpq corta a string no lugar errado e o erro sai como "host não encontrado".
# Gerar sem eles é mais simples: openssl rand -hex 24
#
# Diagnóstico no ar: GET /api/acessos/saude-artefatos (só admin) traz o bloco `banco`
# com configurado/conectado/versão do PostGIS/migração. O /api/health segue mudo de
# propósito (pentest Onda B #8) e NÃO olha o banco: o piloto foi desenhado para servir
# sem ele, e amarrar os dois faria o Docker reiniciar o web a cada piscada do Postgres.
MOTOR_DATABASE_URL=

# Credencial do DONO em formato URL, usada SÓ pelo runner de migration
# (`python -m motor_expansao.db aplicar`). Deliberadamente FORA do compose: ela é
# passada na invocação do comando, num container efêmero, para nunca ficar no
# ambiente do processo `web` que atende requisição. Ver docs/banco_conexao.md.
#   MOTOR_DATABASE_URL_ADMIN=postgresql://reservas_owner:SENHA@postgres:5432/banco_de_reservas

# ── Administração de usuários (D25 / criação na D26) ──────────────────────────
# Allowlist do painel de Acessos, comparada com o `Remote-User` do Authelia
# (case-insensitive, separada por vírgula). Ela vive FORA do RBAC de propósito
# (emenda DEC-027): VAZIA = o painel responde 404 para TODO MUNDO, em dev e em
# produção, e a aba nem aparece no menu. É deny-by-default, não esquecimento — mas
# é também a causa mais barata de "a tela de administração desapareceu".
MOTOR_ACESSOS_ADMIN_USUARIOS=

# Senha INICIAL entregue a quem é criado pela tela de administração (D26). Cada
# pessoa recebe o hash Argon2id dela com SAL PRÓPRIO, e nasce marcada para trocar
# (`deve_trocar_senha_usuario`, migration 016).
#
# SEM DEFAULT, pelo mesmo motivo do MOTOR_DATABASE_URL: um valor embutido no fonte
# deixa de ser ruído no dia em que há banco real no ar e vira caminho de entrada
# (ver tests/contracts/test_sem_credencial_morta.py). AUSENTE ou vazia, criar
# usuário é RECUSADO com 503 e mensagem explícita — criar alguém com uma senha que
# ninguém sabe qual é seria pior que não criar.
#
# Ela é COMPARTILHADA por construção, então trate-a como senha de porta de entrada,
# não como segredo: 12+ caracteres, trocada quando alguém sai da empresa, e nunca a
# mesma de nenhum outro sistema. A política do motor recusa que uma pessoa "troque"
# a senha dela pela inicial — senão todo mundo ficaria com a mesma e a coluna
# `senha_definida_em_usuario` afirmaria que ela definiu a própria.
#
# Gerar: openssl rand -base64 18
MOTOR_SENHA_INICIAL=

# ── A CHAVE DO P19: quem autentica o piloto ───────────────────────────────────
# VAZIA = o Authelia autentica, como hoje. É o estado de produção, e é o default.
# Qualquer valor não-vazio = o MOTOR autentica: o portão de sessão passa a valer em
# toda requisição, e `/api/login`, `/api/logout` e `/api/verify` saem do 404.
#
# NÃO VIRE ESTA CHAVE SOZINHA. Ela é metade de um par, e a ordem importa:
#   1º  ligue esta chave e reinicie o `web`;
#   2º  SÓ ENTÃO reaponte o `forward_auth` do Caddy, do serviço `authelia` para o
#       nosso backend (DEC-067, D4; bloco pronto em
#       `deploy/caddy/piloto-ar.Caddyfile.template`).
# Na ordem inversa o piloto CAI INTEIRO: o Caddy pergunta ao `/api/verify`, que
# responde 404 com a chave desligada, e ele nega tudo que não for 2xx — inclusive
# para quem já estava dentro.
#
# PRÉ-REQUISITOS, ou ligar a chave só troca um problema por outro:
#   * `MOTOR_DATABASE_URL` preenchida e o banco no ar — a sessão vive em TABELA
#     (D30/migration 018), então sem banco ninguém entra;
#   * migrations 018, 019 e 020 aplicadas (`docs/repasse_migracoes_p19.md`);
#   * TODA linha de `usuarios` com `senha_hash` em formato Argon2id (começa com
#     `$argon2id$`). Quem NÃO tiver fica trancado, e é este o risco real — não
#     "quem está na senha inicial". Quem nasceu pela tela de Acessos recebeu o hash
#     REAL da `MOTOR_SENHA_INICIAL`, com sal próprio, e entra normalmente no dia do
#     corte. Quem fica de fora é a linha semeada por SQL à mão (`hash_de_teste_*` e
#     afins): `db/senhas.py::verificar` recusa qualquer coisa fora do formato PHC.
#     Medir ANTES, com o banco no ar:
#       SELECT login_usuario FROM usuarios
#        WHERE ativo AND (senha_hash IS NULL OR senha_hash NOT LIKE '$argon2id$%');
#     Linha nessa lista = pessoa que não entra depois do corte. Resolva antes.
#
# Para DESFAZER, e a ORDEM é o inverso da de ligar:
#   1º  devolva o `forward_auth` ao `authelia:9091` e recarregue o Caddy;
#   2º  SÓ ENTÃO esvazie esta variável e suba o `web` de novo.
# Invertido, você passa pelo mesmo apagão de ligar na ordem errada: com a chave já
# desligada e o Caddy ainda perguntando ao `/api/verify`, a rota responde 404 e o
# Caddy nega tudo.
#
# O gesto é `docker compose -f docker-compose.prod.yml up -d web`, NÃO
# `docker compose restart web`: o `restart` NÃO relê o `.env`, então o container
# voltaria com o ambiente antigo e nada mudaria — nos dois momentos críticos.
#
# Nada no BANCO precisa ser revertido. Mas as PESSOAS sim: quem trocou de senha
# depois do corte volta a precisar da senha que usava ANTES dele (o Authelia nunca
# soube da nova), e quem foi CRIADO depois do corte não existe no `users_database.yml`
# e não entra de jeito nenhum. Enquanto durar a janela de observação, continue
# cadastrando toda pessoa nova no Authelia — é esse cadastro que torna o rollback
# sobrevivível.
MOTOR_AUTENTICACAO_PROPRIA=

# ── Backup do banco (F2.4 — reabre o BLK-SEC-04) ──────────────────────────────
# Consumidas por scripts/cron/run_backup_banco.sh, NÃO pelo compose. Ausentes, o
# cron ainda roda e grava o dump no disco da VPS — mas avisa alto que a cópia
# off-box está desligada, porque um backup que só existe no disco que ele deveria
# proteger não cobre perda de disco nem conta de provedor comprometida.
#
# restic (não rclone) de propósito: o dump carrega e-mail, `login_usuario`,
# `senha_hash` e o `ip` dos eventos. O restic cifra ANTES de sair da máquina, com
# uma chave que o dono do bucket não tem. Sync de arquivo cru entregaria PII em
# claro a um terceiro.
#
# Repositório S3-compatível no free tier (Backblaze B2 ou Cloudflare R2, 10 GB):
#   BACKUP_RESTIC_REPOSITORY=s3:s3.us-west-004.backblazeb2.com/BUCKET/banco
# A senha do repositório é a CHAVE DE DECIFRAÇÃO: perdê-la é perder todo o backup,
# e ela não pode viver só neste .env — guarde a cópia no mesmo cofre do SOPS+age.
BACKUP_RESTIC_REPOSITORY=
BACKUP_RESTIC_PASSWORD=
# Application key do bucket, com permissão apenas neste prefixo (não a master key
# da conta: uma VPS comprometida não deve conseguir apagar backups de mais nada).
BACKUP_S3_KEY_ID=
BACKUP_S3_KEY_SECRET=
