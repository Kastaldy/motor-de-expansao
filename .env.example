# ============================================================
# Motor de Expansão Ultra Academia — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env — apenas o .env.example
# ============================================================

# --- Banco de Dados ---
POSTGRES_USER=ultra
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=motor_expansao
DATABASE_URL=postgresql+asyncpg://ultra:sua_senha_aqui@localhost:5432/motor_expansao
DATABASE_URL_SYNC=postgresql+psycopg2://ultra:sua_senha_aqui@localhost:5432/motor_expansao

# --- APIs Externas ---
GOOGLE_MAPS_API_KEY=sua_chave_aqui        # Geocodificação + Places
GEOFUSION_API_KEY=sua_chave_aqui          # Dados demográficos e de consumo
MAPBOX_TOKEN=sua_chave_aqui              # Frontend — mapas

# --- Monitoramento ---
SENTRY_DSN=sua_dsn_aqui
ENVIRONMENT=development                   # development | staging | production

# --- Autenticação ---
SECRET_KEY=gere_uma_chave_segura_aqui    # python -c "import secrets; print(secrets.token_hex(32))"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Prefect ---
PREFECT_API_URL=http://localhost:4200/api

# --- Configurações de Scraping ---
SCRAPER_DELAY_MIN=2                       # segundos mínimos entre requests
SCRAPER_DELAY_MAX=5                       # segundos máximos entre requests
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT=30

# --- Configurações Geoespaciais ---
H3_RESOLUTION=8
DIST_MIN_ULTRA_KM=2.0
RENDA_MIN=3000

# --- Alertas ---
SLACK_WEBHOOK_URL=sua_webhook_aqui        # opcional
ALERT_EMAIL=seuemail@ultra.com.br         # opcional
