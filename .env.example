# ============================================================
# Motor de Expansão Ultra Academia — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env — apenas o .env.example
# ============================================================

# --- Banco de Dados ---
POSTGRES_USER=ultra
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=motor_expansao
DATABASE_URL=postgresql+asyncpg://ultra:sua_senha_aqui@localhost:5432/motor_expansao
DATABASE_URL_SYNC=postgresql+psycopg2://ultra:sua_senha_aqui@localhost:5432/motor_expansao

# --- APIs Externas ---
GOOGLE_MAPS_API_KEY=                      # Opcional no M1 nacional; sem chave a vitalidade fica neutra
GEOFUSION_API_KEY=                        # Futuro/opcional; fora do fechamento oficial do M1
MAPBOX_TOKEN=                             # Futuro/frontend; fora do escopo atual do M1

# --- Monitoramento ---
SENTRY_DSN=sua_dsn_aqui
ENVIRONMENT=development                   # development | staging | production

# --- Autenticação ---
SECRET_KEY=gere_uma_chave_segura_aqui    # python -c "import secrets; print(secrets.token_hex(32))"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Configurações de Scraping ---
SCRAPER_DELAY_MIN=2                       # segundos mínimos entre requests
SCRAPER_DELAY_MAX=5                       # segundos máximos entre requests
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT=30

# --- Configurações Geoespaciais / M1 ---
H3_RESOLUTION=7
DIST_MIN_ULTRA_KM=1.0
RENDA_MIN=4500
M1_SCORE_OFICIAL=hex_score_estrutural
M1_PRIORIZACAO_TOP_PCT_POR_UF=0.20
M1_OSM_ENABLED=false                      # OSM é opcional/futuro; não fecha o MVP nacional atual
M1_SETOR_CENSITARIO_OBRIGATORIO=false     # Setor segue desejável, mas SIDRA municipal é fallback oficial atual

# --- Alertas ---
SLACK_WEBHOOK_URL=sua_webhook_aqui        # opcional
ALERT_EMAIL=seuemail@ultra.com.br         # opcional
