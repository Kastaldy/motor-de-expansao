# Bloco do Caddy para a instancia ARGENTINA do piloto (Bloco E / BLK-INTL-08).
#
# TEMPLATE versionado: o Caddyfile REAL e' gitignored (backup cifrado em secrets/Caddyfile.enc)
# e vive na VPS em /opt/motor-expansao/app/Caddyfile.
#
# ============================================================================
# A AR TAMBEM CORTA (DEC-081). Este bloco passa a ESPELHAR o do BR: o `forward_auth`
# aponta para o NOSSO `/api/verify` (gateado por pais), nao mais para o Authelia. Isto
# REVOGA a emenda "D4 so' para o Brasil" da DEC-067 -- ate' 2026-10-29 este arquivo dizia
# "A AR FICA NO AUTHELIA, NAO TOQUE", porque a AR nao tinha banco; a DEC-081 da' banco a ela.
#
# ORDEM FAIL-CLOSED -- a aplicacao na VPS e' MANUAL (Estagio 2 da DEC-081; CLAUDE.md §6,
# comando a comando). O `web_ar` precisa de BANCO (`MOTOR_DATABASE_URL`) + a chave
# `MOTOR_AUTENTICACAO_PROPRIA` ligada + os usuarios AR semeados com o pais AR, tudo ANTES de
# este bloco apontar para ca'. Invertido, o `/api/verify` do web_ar responde 404 (chave off)
# ou 503 (sem banco), e o Caddy nega tudo que nao for 2xx -- a AR cairia inteira. Ver
# docker-compose.ar.yml (MOTOR_DATABASE_URL + volume de cadastro) e o repasse do corte AR.
#
# O GATE DE PAIS (DEC-081) substitui a separacao que o grupo `expansao_ar` do Authelia fazia: o
# `/api/verify` do processo AR (PERFIL.pais = AR) so' libera quem tem o pais AR entre os seus.
# Ninguem so'-BR entra aqui: o cookie e' `__Host-` POR HOST (Opcao F, DEC-081 -- sem SSO de
# dominio; login por host), entao o so'-BR nem tem sessao neste host; e, mesmo que tivesse, o
# gate barra na borda e a 2a camada (`_portao_de_sessao`) barra de novo no processo.
# ============================================================================
#
# UMA diferenca deliberada em relacao ao BR: o BR usa `reverse_proxy web:8899` (alias de
# SERVICO, Caddy e `web` no MESMO compose). O `web_ar` mora no docker-compose.ar.yml (project
# motor-expansao-ar), entao o alias de servico NAO cruza projects -- o alvo e' o `container_name`
# (`motor_expansao_web_ar`), resolvido na rede compartilhada app_app_net.

piloto-ar.ultra-expansao.tech {
    # As CINCO rotas de fora sao as MESMAS de `acesso.ROTAS_PUBLICAS_SEM_SESSAO` (igual ao BR):
    # login/logout/health/verify/verify-sessao. A raiz e os estaticos ficam publicos (a tela de
    # login e' a propria SPA); so' o primeiro `/api/*` protegido devolve 401.
    @protegido {
        path /api/*
        not path /api/login /api/logout /api/health /api/verify /api/verify-sessao
    }

    # A BORDA FICA, mudando so' o ALVO: de `authelia:9091` para o nosso `web_ar`. `?rd=` SAI
    # (nao ha' mais host externo de login; quem leva a' tela e' o proprio SPA,
    # `relatarAcessoNegado` em `web/src/lib/sessao.ts`). `Remote-Name` sai do `copy_headers`
    # (zero leitores, medido -- igual ao BR). O gate de pais do `/api/verify` garante que so'
    # quem tem o pais AR passa.
    forward_auth @protegido motor_expansao_web_ar:8899 {
        uri /api/verify
        copy_headers Remote-User Remote-Groups Remote-Email
    }
    reverse_proxy motor_expansao_web_ar:8899
    # Access log de edge do host AR (DEC-027 — metade da trilha: IP real, user-agent, latencia
    # no Caddy; a outra metade e' o JSONL do backend). CONFERIR o formato contra o bloco BR na
    # hora de aplicar. /var/log/caddy e' o mount de /opt/motor-expansao/logs/caddy.
    log {
        output file /var/log/caddy/piloto-ar-access.log
    }
}
