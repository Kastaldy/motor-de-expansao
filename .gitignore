# Dados sensiveis e staging (nunca commitar)
NAO_ABRA/
data/raw/
data/staging/*
data/snapshots/
data/ultra/
data/osm_cache/
# Cadastro operacional (consultor, franqueado, master franquia): dado real de negocio,
# semeado da planilha do time de campo. E o default de MOTOR_CADASTRO_DIR, entao aparece
# aqui em qualquer maquina que rode o piloto local — em producao ele vive num volume :rw.
data/cadastro/
data/models/*.pkl
data/models/*.joblib
concorrentes/
*.parquet
*.csv
*.xlsx
*.tmp.md
data/outputs/_manifest.json
# Malha geo de setores censitarios 2022 (artefato pesado ~1.2 GB; vai por scp, nao por git).
# Os *.parquet ja sao ignorados acima; aqui pegamos o _report.md e demais nao-parquet,
# preservando so o _metadata.json (marcador versionado do artefato).
data/outputs/setores_censitarios_2022_geo/**
!data/outputs/setores_censitarios_2022_geo/_metadata.json
# Pasta de staging do duplo-aninhamento (caso o pipeline volte a materializar aqui).
data/setores_censitarios_2022_geo/
!tests/contracts/fixtures/*.html

# Excecao (BLK-DIM-00, decisao D2): estrutura parametrica do simulador financeiro
# e metadado COMMITABLE (mapeamento celula->driver / defaults / ratios %), sem PII
# de aluno nem dado financeiro real de unidade. Versionado por path.
!data/staging/simulador_estrutura.json

# Fixtures de teste versionadas (sinteticas, sem dado real) - excecao ao ignore de parquet/csv
!tests/fixtures/
!tests/fixtures/**

