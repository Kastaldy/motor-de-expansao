{
  "version": 8,
  "name": "Satélite + overlay claro (ideia E)",
  "metadata": {
    "ultra:desc": "Imagem de satélite Esri (hosted) + overlay branco semitransparente + rótulos essenciais servidos pelo self-host. Imagem global de satélite é sempre externa (não se self-hosta)."
  },
  "sources": {
    "esri": {
      "type": "raster", "tileSize": 256,
      "tiles": ["https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"],
      "attribution": "Esri, Maxar, Earthstar Geographics"
    },
    "openmaptiles": { "type": "vector", "url": "mbtiles://{brazil}" },
    "overlay": {
      "type": "geojson",
      "data": { "type": "Feature", "properties": {}, "geometry": {
        "type": "Polygon",
        "coordinates": [[[-180, -85], [180, -85], [180, 85], [-180, 85], [-180, -85]]] } }
    }
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "layers": [
    { "id": "sat", "type": "raster", "source": "esri",
      "paint": { "raster-saturation": -0.25, "raster-contrast": -0.05 } },

    { "id": "haze", "type": "fill", "source": "overlay",
      "paint": { "fill-color": "#ffffff", "fill-opacity": 0.34 } },

    { "id": "road-major", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 10,
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
      "paint": { "line-color": "#ffffff",
                 "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 2.4, 16, 6], "line-opacity": 0.55 } },

    { "id": "water-name", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name", "minzoom": 10,
      "layout": { "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
                  "text-font": ["Open Sans Italic"], "text-size": 11 },
      "paint": { "text-color": "#0c2a4a", "text-halo-color": "#ffffff", "text-halo-width": 1.3 } },

    { "id": "place-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["match", ["get", "class"], ["city", "town", "suburb", "neighbourhood"], true, false],
      "layout": { "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
                  "text-font": ["Open Sans Semibold"],
                  "text-size": ["interpolate", ["linear"], ["zoom"], 8, 11, 12, 15],
                  "text-letter-spacing": 0.02 },
      "paint": { "text-color": "#0f172a", "text-halo-color": "#ffffff", "text-halo-width": 1.7 } }
  ]
}
