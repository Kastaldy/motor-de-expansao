{
  "version": 8,
  "name": "Ultra Labels (so rotulos, fundo transparente)",
  "metadata": {
    "ultra:desc": "Estilo SO-DE-ROTULOS servido pelo tileserver proprio, para compor os NOMES de rua/avenida/bairro POR CIMA do choropleth dos mapas de calor. Substitui o tileset only-labels do CARTO (BLK-BASEMAP-06). Sem geometria de fundo: o fundo de ruas vem do estilo `ultra-maptiler`, este aqui so carimba texto.",
    "ultra:tamanhos": "O texto e' DELIBERADAMENTE maior que o de um basemap de tela. Este mosaico e' buscado no MESMO zoom do frame (bump 0) e depois o PNG de 1280x760 ainda e' reduzido ao entrar no PDF; com os tamanhos de um estilo normal os nomes chegariam ao relatorio com ~3 pt."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "mbtiles://{brazil}"
    }
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "fundo-transparente",
      "type": "background",
      "paint": { "background-color": "rgba(0,0,0,0)" }
    },

    {
      "id": "rotulo-via-principal",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 11,
      "filter": ["match", ["get", "class"],
                 ["motorway", "trunk", "primary", "secondary"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 15, 14, 19, 17, 23],
        "text-max-angle": 35,
        "symbol-spacing": 320,
        "text-padding": 4
      },
      "paint": {
        "text-color": "hsl(0,0%,12%)",
        "text-halo-color": "hsl(0,0%,100%)",
        "text-halo-width": 2.2
      }
    },

    {
      "id": "rotulo-via-secundaria",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "filter": ["match", ["get", "class"],
                 ["tertiary", "minor", "residential", "street", "unclassified"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 15, 17, 19],
        "text-max-angle": 35,
        "symbol-spacing": 280,
        "text-padding": 4
      },
      "paint": {
        "text-color": "hsl(0,0%,22%)",
        "text-halo-color": "hsl(0,0%,100%)",
        "text-halo-width": 2.0
      }
    },

    {
      "id": "rotulo-bairro",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 11,
      "filter": ["match", ["get", "class"],
                 ["suburb", "neighbourhood", "quarter", "village", "town", "city"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 18, 14, 24, 17, 30],
        "text-letter-spacing": 0.04,
        "text-padding": 6
      },
      "paint": {
        "text-color": "hsl(0,0%,8%)",
        "text-halo-color": "hsl(0,0%,100%)",
        "text-halo-width": 2.6
      }
    },

    {
      "id": "rotulo-agua",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 12,
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 15, 16, 19]
      },
      "paint": {
        "text-color": "hsl(205,42%,32%)",
        "text-halo-color": "hsl(0,0%,100%)",
        "text-halo-width": 2.0
      }
    }
  ]
}
